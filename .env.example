# Copie este arquivo para ".env" e preencha com os seus dados.
# O arquivo .env NUNCA deve ser enviado para o GitHub (já está no .gitignore).

# Sistema web (automações 01 e 02)
SISTEMA_URL=https://sistema-juridico.exemplo.com.br
SISTEMA_USUARIO=seu.usuario
SISTEMA_SENHA=sua-senha-aqui
SISTEMA_TIPO_DOCUMENTO=COMPROVANTE

# Pastas de trabalho
PASTA_COMPROVANTES=./entrada
PASTA_PLANILHAS_CUSTAS=./planilhas

# Senha da planilha protegida do malote (automação 05)
SENHA_PLANILHA_MALOTE=
